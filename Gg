local function getAdaptiveSize()
	local viewport = Camera.ViewportSize
	if viewport.X <= 600 or viewport.Y <= 500 then
		return UDim2.fromOffset(260, 380), 12
	elseif viewport.X <= 1024 or viewport.Y <= 768 then
		return UDim2.fromOffset(300, 420), 14
	else
		return UDim2.fromOffset(320, 450), 15
	end
end

--========================================================--
-- VISUAL (GRADIENTES AZUIS & RGB)
--========================================================--

local function addCorner(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = parent
	return corner
end

local function borderSequence()
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(10, 90, 180)),
		ColorSequenceKeypoint.new(0.35, Color3.fromRGB(10, 160, 255)),
		ColorSequenceKeypoint.new(0.6, Color3.fromRGB(80, 215, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 100, 180))
	})
end

local function addGradientStroke(parent, thickness)
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Thickness = thickness
	stroke.Color = Color3.new(1, 1, 1)
	stroke.Parent = parent

	local gradient = Instance.new("UIGradient")
	gradient.Color = borderSequence()
	gradient.Parent = stroke

	return gradient
end

